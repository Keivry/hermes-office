@@ -239,6 +239,17 @@ def _run_git(args: List[str], store: Path, working_dir: str, timeout: int = _GIT
         logger.error("Git command skipped: %s (%s)", " ".join(cmd), msg)
         return False, "", msg
 
+    # Bare-store self-heal: `git gc --prune=now` on a bare repo with only
+    # packed refs can delete the empty refs/heads/ (and branches/) dirs.
+    # Git 2.34+ then reports `fatal: not a git repository` for every
+    # subsequent command until the dirs are recreated. This was observed
+    # in the wild as `git add -A` spamming ERROR after each auto-prune
+    # (see #65349, #79334, #83036 and the local 015 fix for #78888).
+    # The repair is a cheap mkdir-if-missing, so run it proactively
+    # before every git invocation when the store already exists.
+    if _store_has_head(store):
+        _repair_bare_repo_dirs(store)
+
     try:
         result = _git_subprocess(cmd, _git_env(store, str(wd), index_file=index_file), timeout, cwd=str(wd))
     except subprocess.TimeoutExpired:
@@ -260,6 +271,23 @@ def _run_git(args: List[str], store: Path, working_dir: str, timeout: int = _GIT
     # NUL-delimited output contains literal paths, including leading spaces.
     stdout = result.stdout if "-z" in args else result.stdout.strip()
     stderr = result.stderr.strip()
+    if not ok and "not a git repository" in stderr and _store_has_head(store):
+        # Self-heal once and retry: the store's refs/heads may have been
+        # removed by a concurrent or just-finished `git gc` (see above).
+        _repair_bare_repo_dirs(store)
+        try:
+            retry = _git_subprocess(cmd, _git_env(store, str(wd), index_file=index_file), timeout, cwd=str(wd))
+            ok = retry.returncode == 0
+            stdout = retry.stdout if "-z" in args else retry.stdout.strip()
+            stderr = retry.stderr.strip()
+            if ok:
+                logger.debug("Git command healed after bare-repo repair: %s", " ".join(cmd))
+            elif retry.returncode not in (allowed_returncodes or set()):
+                logger.error("Git command failed: %s (rc=%d) stderr=%s",
+                             " ".join(cmd), retry.returncode, stderr)
+            return ok, stdout, stderr
+        except Exception as exc2:  # pragma: no cover
+            logger.debug("Retry after bare-repo repair failed: %s", exc2)
     if not ok and result.returncode not in (allowed_returncodes or set()):
         logger.error("Git command failed: %s (rc=%d) stderr=%s",
                      " ".join(cmd), result.returncode, stderr)
@@ -414,6 +442,8 @@ def _init_store(store: Path, working_dir: str) -> Optional[str]:
             return f"Could not create checkpoint base: {exc}"
         _migrate_legacy_store(base)
