@@ -230,6 +230,28 @@ def _store_has_head(store: Path) -> bool:
     return (store / "HEAD").exists()
 
 
+def _repair_bare_repo_dirs(store: Path) -> None:
+    """Recreate the bare store's ``refs/heads`` and ``branches`` directories.
+
+    git's ``is_git_directory()`` requires ``HEAD`` plus an ``objects/`` and a
+    ``refs/`` directory; when the store loses one of them every command fails
+    with ``fatal: not a git repository: '/.../checkpoints/store'`` -- including
+    the ``git gc`` of the next prune, so the store cannot repair itself and
+    every checkpoint silently fails (observed live in this deployment as
+    ``git add -A`` spamming that fatal for hours).  ``mkdir(parents=True)`` on
+    ``refs/heads`` also recreates ``refs/`` itself.  Cheap and idempotent, so
+    safe to call before any git invocation.
+    """
+    for subdir in ("refs/heads", "branches"):
+        if (store / subdir).exists():
+            continue
+        try:
+            (store / subdir).mkdir(parents=True, exist_ok=True)
+            logger.debug("Repaired missing %s in checkpoint store", subdir)
+        except OSError as exc:
+            logger.warning("Cannot create %s in checkpoint store: %s", subdir, exc)
+
+
 def _index_path(store: Path, dir_hash: str) -> Path:
     return store / _INDEXES_DIRNAME / dir_hash
 
