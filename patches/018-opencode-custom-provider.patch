+def _is_opencode_custom_name(provider: Optional[str]) -> bool:
+    """True for a name in the ``opencode`` / ``opencode-*`` provider namespace.
+
+    hermes-office 018: a named custom provider fronting the relay
+    (``custom:opencode``, ``custom:opencode-chat``, ...) is flattened to provider
+    ``"custom"`` at runtime, and :func:`opencode_provider_family` from
+    ``hermes_cli.models`` only knows the built-in families (``opencode`` /
+    ``opencode-zen*`` / ``opencode-go*`` / ``opencode-free*``). Everything else
+    in the namespace is matched here, so the whole namespace shares one rule
+    instead of a per-name allowlist. Any vendor prefix (``custom:``) is
+    stripped first.
+    """
+    name = str(provider or "").strip().lower()
+    if ":" in name:
+        name = name.split(":", 1)[1]
+    return name == "opencode" or name.startswith("opencode-")
+
+
