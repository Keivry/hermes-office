# 018 = hermes-office specific (NOT upstream): cover named custom providers
#   that front the OpenCode relay (e.g. `custom:opencode` -> proxy IP).
#
#   Why: at runtime a named custom provider flattens to agent.provider ==
#   "custom" (hermes_cli/runtime_provider.py sets result["provider"] =
#   "custom"), and agent.base_url is the relay-proxy address (e.g.
#   http://<proxy-ip>:8878/v1), so upstream's is_opencode_target misses on
#   BOTH signals: opencode_provider_family("custom") is None and the host is
#   not opencode.ai. The original identity survives in agent.requested_provider
#   ("custom:opencode") on the main turn and in auxiliary_client's
#   _RUNTIME_MAIN_CONTEXT["requested_provider"] for aux calls (set by
#   agent/turn_context.py) — thread it through and match the name against the
#   whole `opencode` / `opencode-*` namespace (helper _is_opencode_custom_name)
#   after stripping any `custom:` prefix. Rationale: opencode_provider_family is
#   a built-in-family allowlist (opencode / opencode-zen* / opencode-go* /
#   opencode-free*), but locally `custom:opencode-chat` and friends front the
#   same relay — so the namespace, not a per-name list, is the matcher. The
#   family check still runs first: hermes_cli.models stays the single owner of
#   the canonical families.
#
#   2026-09-22 rebase (v2026.9.21): upstream rewrote this module —
#   merge_opencode_session_headers -> merge_session_affinity_headers — and added
#   an opt-in `providers.<name>.session_affinity_header` config knob. Re-anchored
#   onto the new API and KEPT, because the config knob has no `oneshot-<hex>`
#   fallback: a relay that hard-requires the header (OpenCode Go 400s with
#   MissingSessionID, #105841) would still see headerless stateless requests.
#   The knob is also matched by base_url route, so it only covers entries the
#   operator explicitly annotates.
#
#   The current live config (providers.opencode / opencode-chat ->
#   https://opencode.ai/zen/go/v1) is already covered by upstream's
#   _is_opencode_endpoint host match, so this patch is a no-op today and earns
#   its keep only when a base_url sits off opencode.ai (the commented-out
#   internal proxy). Always apply in lexicographic order; do NOT dry-run
#   standalone.
diff --git a/agent/auxiliary_client.py b/agent/auxiliary_client.py
--- a/agent/auxiliary_client.py
+++ b/agent/auxiliary_client.py
@@ -6621,7 +6621,13 @@ def _build_call_kwargs(
     # Conversation affinity (OpenCode relay, opt-in custom-provider header) — same key as the main
     # turn so compression/title/vision calls stay on the conversation's warm backend.
     from agent.opencode_affinity import merge_session_affinity_headers
-    return merge_session_affinity_headers(kwargs, provider, base_url, _runtime_main_value("session_id") or None)
+    # hermes-office 018: aux calls for a named custom provider also arrive as
+    # provider "custom"; recover the recorded main identity from the turn
+    # context (agent/turn_context.py stores requested_provider).
+    return merge_session_affinity_headers(
+        kwargs, provider, base_url, _runtime_main_value("session_id") or None,
+        requested_provider=_runtime_main_value("requested_provider") or None,
+    )
 
 
