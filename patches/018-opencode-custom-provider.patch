# 018 = hermes-office specific (NOT upstream): cover named custom providers
#   that front the OpenCode relay (e.g. `custom:opencode` -> proxy IP).
#
#   Why: at runtime a named custom provider flattens to agent.provider ==
#   "custom" (hermes_cli/runtime_provider.py sets result["provider"] =
#   "custom"), and agent.base_url is the relay-proxy address (e.g.
#   http://<proxy-ip>:8878/v1), so upstream PR #101864's is_opencode_target
#   misses on BOTH signals: opencode_provider_family("custom") is None and
#   the host is not opencode.ai. The original identity survives in
#   agent.requested_provider ("custom:opencode") on the main turn and in
#   auxiliary_client's _RUNTIME_MAIN_CONTEXT["requested_provider"] for aux
#   calls (set by agent/turn_context.py) — thread it through and match the
#   name against the whole `opencode` / `opencode-*` namespace (helper
#   _is_opencode_custom_name) after stripping any `custom:` prefix.
#   Rationale: opencode_provider_family is a built-in-family allowlist
#   (opencode / opencode-zen* / opencode-go* / opencode-free*), but locally
#   `custom:opencode-chat` and friends front the same relay — so the
#   namespace, not a per-name list, is the matcher. The family check still
#   runs first: hermes_cli.models stays the single owner of the canonical
#   families.
#
#   2026-09-14 rebase: #101864 (017) is now IN the base tag v2026.9.11, so
#   this patch is rebased directly onto upstream's rewritten
#   agent/opencode_affinity.py (is_opencode_target now also matches by
#   base_url host "opencode.ai"). Still needed for a base_url NOT on
#   opencode.ai (the commented-out internal proxy). Always apply in
#   lexicographic order; do NOT dry-run standalone.
diff --git a/agent/auxiliary_client.py b/agent/auxiliary_client.py
--- a/agent/auxiliary_client.py
+++ b/agent/auxiliary_client.py
@@ -6142,7 +6142,17 @@ def _build_call_kwargs(
     # OpenCode relay session affinity — same key as the main turn so compression/title/vision
     # calls stay on the conversation's warm backend.
     from agent.opencode_affinity import merge_opencode_session_headers
-    return merge_opencode_session_headers(kwargs, provider, base_url, _runtime_main_value("session_id") or None)
+
+    # hermes-office 018: aux calls for a named custom provider also arrive
+    # as provider "custom"; recover the recorded main identity from the
+    # turn context (agent/turn_context.py stores requested_provider).
+    return merge_opencode_session_headers(
+        kwargs,
+        provider,
+        base_url,
+        _runtime_main_value("session_id") or None,
+        requested_provider=_runtime_main_value("requested_provider") or None,
+    )
 
 
 def _validate_llm_response(
diff --git a/agent/chat_completion_helpers.py b/agent/chat_completion_helpers.py
--- a/agent/chat_completion_helpers.py
+++ b/agent/chat_completion_helpers.py
@@ -1383,11 +1383,15 @@ def build_api_kwargs(agent, api_messages: list, tools_for_api: list | None = Non
     from agent.opencode_affinity import merge_opencode_session_headers
 
     kwargs = _build_api_kwargs_for_mode(agent, api_messages, tools_for_api)
+    # hermes-office 018: pass the pre-canonicalization identity so named
+    # custom providers fronting the relay (custom:opencode -> proxy IP,
+    # runtime provider flattened to "custom") still match. No-op otherwise.
     return merge_opencode_session_headers(
         kwargs,
         getattr(agent, "provider", None),
         getattr(agent, "base_url", None),
         getattr(agent, "session_id", None),
+        requested_provider=getattr(agent, "requested_provider", None),
     )
 
 
diff --git a/agent/opencode_affinity.py b/agent/opencode_affinity.py
--- a/agent/opencode_affinity.py
+++ b/agent/opencode_affinity.py
@@ -22,17 +22,58 @@ from typing import Any, Optional
 OPENCODE_SESSION_HEADER = "x-opencode-session"
 
 
-def is_opencode_target(provider: Optional[str], base_url: Optional[str]) -> bool:
+def _is_opencode_custom_name(provider: Optional[str]) -> bool:
+    """True for a name in the ``opencode`` / ``opencode-*`` provider namespace.
+
+    hermes-office 018: a named custom provider fronting the relay
+    (``custom:opencode``, ``custom:opencode-chat``, ``custom:opencode-go-x``,
+    ...) is flattened to provider ``"custom"`` at runtime, and
+    :func:`opencode_provider_family` from ``hermes_cli.models`` only knows the
+    built-in families (``opencode`` / ``opencode-zen*`` / ``opencode-go*`` /
+    ``opencode-free*``). Everything else in the namespace is matched here, so
+    the whole namespace shares one rule instead of a per-name allowlist. Any
+    vendor prefix (``custom:``) is stripped first.
+    """
+    name = str(provider or "").strip().lower()
+    if ":" in name:
+        name = name.split(":", 1)[1]
+    return name == "opencode" or name.startswith("opencode-")
+
+
+def is_opencode_target(
+    provider: Optional[str],
+    base_url: Optional[str],
+    requested_provider: Optional[str] = None,
+) -> bool:
     """True when *provider* or *base_url* addresses the OpenCode relay.
 
     Matches the built-in opencode-zen/go/free providers, custom
     ``opencode-<family>-*`` providers, and any base_url hosted on opencode.ai.
+
+    hermes-office: also matches named custom providers fronting the relay
+    (e.g. ``custom:opencode`` -> proxy IP). The runtime flattens those to
+    provider ``"custom"`` with a proxy base_url, so both upstream signals
+    miss; the pre-canonicalization identity in *requested_provider* is
+    checked, with any ``custom:`` prefix stripped, against the
+    ``opencode`` / ``opencode-*`` namespace.
     """
+    # hermes-office 018: named custom providers in the opencode namespace.
+    if _is_opencode_custom_name(provider) or _is_opencode_custom_name(
+        requested_provider
+    ):
+        return True
     try:
         from hermes_cli.models import opencode_provider_family
 
         if opencode_provider_family(provider) is not None:
             return True
+        if requested_provider:
+            rp = str(requested_provider).strip().lower()
+            short = rp.split(":", 1)[-1] if ":" in rp else rp
+            if opencode_provider_family(rp) is not None:
+                return True
+            if short != rp and opencode_provider_family(short) is not None:
+                return True
     except Exception:
         pass
     try:
@@ -47,9 +88,10 @@ def opencode_session_headers(
