     return "connected"
 
 
+def _ensure_registered(name: str, server, config: dict) -> bool:
+    """Re-publish this server's tools when this run's registry lost their entries.
+
+    ``_register_connected_into_current_scope`` only heals a *shared* connection's overlay; an
+    owned connection whose scope entries were dropped (a tick that ran while its stdio session
+    was recycled strips them as stale) keeps ``_registered_tool_names`` non-empty, so the
+    reconnect path deliberately skips re-registration and the run stays tool-less. Register
+    again here when the names no longer resolve. Idempotent: a healthy registration returns
+    False without touching the registry.
+    """
+    from tools.registry import registry
+    from tools.mcp_tool_registration import _register_server_tools
+
+    names = list(getattr(server, "_registered_tool_names", []) or ())
+    if names and all(registry.get_entry(tool_name) is not None for tool_name in names):
+        return False
+    registered = _register_server_tools(name, server, config)
+    server._registered_tool_names = sorted(set(names) | set(registered))
+    return bool(registered)
+
+
 def _revive_one(name: str, config: dict, deadline: float, job_id: str) -> str:
     """Bring one configured server back for this run; returns the outcome for the log line."""
     from tools import mcp_tool as core
