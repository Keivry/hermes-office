-            # rather than paying for a second process.
+            # Live transport, but this run's scope may still lack dispatch entries: heal the
+            # shared overlay and re-publish this scope's own registrations when they are gone.
             healed = register_connected_into_current_scope({name: config})
+            if _ensure_registered(name, server, config):
+                return "repaired"
             return f"healed({healed})" if healed else "live_but_unregistered"
         if server._is_recycled_stdio():
-            return "reconnected" if _request_lazy_reconnect(name, server) else "reconnect_failed"
+            if not _request_lazy_reconnect(name, server):
+                return "reconnect_failed"
+            return "repaired" if _ensure_registered(name, server, config) else "reconnected"
         if server._task is not None and not server._task.done():
