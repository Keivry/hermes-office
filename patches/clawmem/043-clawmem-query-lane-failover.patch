+/**
+ * hermes-office patch 043: FAILOVER target for the query-expansion lane.
+ *
+ * The query lane is the one lane that may point at a host which is not always
+ * up (a laptop GPU box). Patch 041 bounds the damage of that — a 400ms probe and
+ * a 300s cooldown — but the answer to "the box is off" is still a typed
+ * fallback, i.e. NO expansion at all. When a second endpoint exists that is
+ * always on (a CPU box running the same qmd-query-expansion model), paying 3-6s
+ * for a real expansion beats paying 0.4s for none.
+ *
+ * This instance is only ever consulted when the PRIMARY lane produced a typed
+ * fallback, so a healthy primary costs nothing extra. It carries its own probe
+ * and cooldown state: the failover target being down must not put the primary
+ * lane into cooldown, and vice versa.
+ *
+ * Same model name on both lanes is the intended shape: identical prompt, same
+ * fine-tune, so the expansion cache key (which fingerprints the model name, not
+ * the endpoint) stays shared and a cached expansion survives the laptop going
+ * offline. Different model names get different cache keys, which is also right.
+ *
+ * Env:
+ *   CLAWMEM_QUERY_FALLBACK_URL              e.g. http://127.0.0.1:9089/v1
+ *   CLAWMEM_QUERY_FALLBACK_MODEL            optional
+ *   CLAWMEM_QUERY_FALLBACK_API_KEY          optional, falls back to the primary lane's key
+ *   CLAWMEM_QUERY_FALLBACK_REASONING_EFFORT optional, unset by default
+ *   CLAWMEM_QUERY_FALLBACK_NO_THINK         optional, falls back to the primary lane's value
+ *
+ * Returns null when unset, which is the whole feature's off switch.
+ */
+export function getExpansionFallbackLlamaCpp(): LlamaCpp | null {
+  const fallbackUrl = process.env.CLAWMEM_QUERY_FALLBACK_URL?.trim();
+  if (!fallbackUrl) return null;
+  if (!expansionFallbackLlamaCpp) {
+    expansionFallbackLlamaCpp = new LlamaCpp({
+      remoteLlmUrl: fallbackUrl,
+      remoteLlmApiKey: process.env.CLAWMEM_QUERY_FALLBACK_API_KEY?.trim()
+        || process.env.CLAWMEM_QUERY_API_KEY?.trim()
+        || process.env.CLAWMEM_LLM_API_KEY || undefined,
+      remoteLlmModel: process.env.CLAWMEM_QUERY_FALLBACK_MODEL?.trim() || undefined,
+      remoteLlmReasoningEffort: process.env.CLAWMEM_QUERY_FALLBACK_REASONING_EFFORT || undefined,
+      remoteLlmNoThink: normalizeRemoteLlmNoThink(
+        process.env.CLAWMEM_QUERY_FALLBACK_NO_THINK
+          ?? process.env.CLAWMEM_QUERY_NO_THINK
+          ?? process.env.CLAWMEM_LLM_NO_THINK,
+      ),
+      remoteLlmProbe: queryLaneProbe() ?? undefined,
+    });
+  }
+  return expansionFallbackLlamaCpp;
+}
