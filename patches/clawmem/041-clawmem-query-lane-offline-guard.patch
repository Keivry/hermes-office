+/**
+ * hermes-office patch 041 (local): one bounded TCP connect attempt.
+ * `net.connect` plus a hard timer: a dropped SYN cannot park the caller past
+ * `timeoutMs` the way an abort-free fetch does.
+ */
+function probeTcpOnce(host: string, port: number, timeoutMs: number): Promise<boolean> {
+  return new Promise<boolean>((resolve) => {
+    let settled = false;
+    let socket: Socket | null = null;
+    const finish = (ok: boolean) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      try {
+        socket?.destroy();
+      } catch {
+        /* already gone */
+      }
+      resolve(ok);
+    };
+    const timer = setTimeout(() => finish(false), timeoutMs);
+    try {
+      socket = netConnect({ host, port });
+    } catch {
+      finish(false);
+      return;
+    }
+    socket.setTimeout(timeoutMs);
+    socket.once("connect", () => finish(true));
+    socket.once("error", () => finish(false));
+    socket.once("timeout", () => finish(false));
+  });
+}
