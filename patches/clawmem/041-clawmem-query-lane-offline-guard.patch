+/**
+ * hermes-office patch 041 (local): abort fuse for the query-expansion lane.
+ * `expandQuery` has no connect timeout of its own, so a powered-off endpoint
+ * parks the caller in the kernel SYN retry ladder (~132s) before any transport
+ * error can trip a cooldown. A deadline turns that fetch into a real abort.
+ * Applied ONLY when the lane is configured, so the shared default lane keeps
+ * stock behaviour. Env: CLAWMEM_QUERY_DEADLINE_MS (default 8000, 0 disables).
+ */
+function queryLaneFuseDeadline(): MonoDeadline | undefined {
+  if (!process.env.CLAWMEM_QUERY_URL?.trim()) return undefined;
+  const raw = process.env.CLAWMEM_QUERY_DEADLINE_MS;
+  const ms = raw === undefined || raw.trim() === "" ? 8_000 : Number(raw);
+  if (!Number.isFinite(ms) || ms <= 0) return undefined;
+  return deadlineAfter(monoNow(), duration(ms));
+}
