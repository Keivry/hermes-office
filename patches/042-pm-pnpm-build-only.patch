# Why: v0.23.1 moved the workspace JS build (frontend_build/webapp_build) from npm to
# pnpm and pm/lock.json now pins `pnpm` 12.15.0. Upstream installs pnpm in the build
# stages ONLY: the runtime stage deliberately carries no pnpm, so a healthy runtime
# install has no `pnpm` row in /opt/hermes/tools/facts.json. pm.drift() treats every
# non-optional lockfile package as required at runtime, so every `hermes ...` dispatch
# prints `install out of sync (pnpm: not installed or outdated)` on stderr and the
# gateway logs it once per boot, with the misleading remedy "this docker-managed
# install must rebuild the artifact to fix" -- rebuilding cannot clear it, the runtime
# stage will never install pnpm. Upstream has no fix at v0.23.1: `class Pnpm` in
# pm/packages.py carries neither `optional` nor `internal`. Rejected alternatives:
# installing pnpm in the child image (tens of MB, adds a package manager upstream
# deliberately keeps out of runtime) and suppressing the message in the logger
# (hides real drift, and the remedy text is generated by the steward).
# After: `class Pnpm` is marked optional = True, matching python/termux-docker and the
# build-only nature of the package. drift() skips optional packages; `pm install pnpm`,
# `pm update --pnpm` and PATH activation are unaffected (optional only feeds drift()
# and the soft-failure path in pm/cli.py).
# Runtime files only: pm/packages.py
# Verified 2026-11-10 on v0.23.1: dry-run rc=0, real apply rc=0, reverse dry-run rc=0, zero
# fuzz/.rej/.orig; py_compile clean; ruff check against the repo pyproject clean;
# check_structure.py clean (class body unchanged, one attribute added); drift() probe
# on the 15-patch roster tree RED before ({pnpm, node}) / GREEN after ({node} only).
# Re-anchor on a base bump: anchor is `class Pnpm` + the `name = "pnpm"` line. RETIRE
# (do not re-anchor) once upstream marks the class optional/internal or stops listing
# pnpm in pm/lock.json -- grep the tag's pm/packages.py for `optional = True` inside
# class Pnpm before touching this file.
--- a/pm/packages.py
+++ b/pm/packages.py
@@ -797,6 +797,11 @@
     (or none) would build them."""
 
     name = "pnpm"
+    # Build-only: the v0.23.1 runtime image ships no pnpm (upstream installs it
+    # in frontend_build/webapp_build only), so a healthy docker install has no
+    # pnpm row in tools/facts.json. Without this flag drift() reports it on
+    # every CLI dispatch and once per gateway boot.
+    optional = True
     # Lifecycle scripts and node-gyp run on the node pm installs.
     deps = ("node",)
     binary_rel = {"win32": "pnpm.exe", "posix": "pnpm"}
