         )
     except Exception:
         logger.debug(
@@ -872,10 +884,21 @@ def _preflight_encrypted(item: dict[str, Any], idx: int, ctx: _PreflightCtx) ->
             return None
         ctx.seen_ids.add(item_id)
     summary = _as_list(item.get("summary"))
-    return {
