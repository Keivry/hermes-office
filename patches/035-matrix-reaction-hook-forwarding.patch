+
+    async def _forward_reaction_event(
+        self,
+        event_name: str,
+        *,
+        room_id: str,
+        user_id: str,
+        event_id: str,
+        target_event_id: str = "",
+        reaction: str = "",
+        removed_reaction_id: str = "",
+        raw_event: Any = None,
+    ) -> None:
+        """Fan one native reaction event out to ``set_reaction_handler`` (HookRegistry.emit).
+
+        Payload keys follow the contract documented on ``set_reaction_handler``
+        (gateway/platforms/base.py): ``platform``, ``event_name`` ("reaction:added" /
+        "reaction:removed"), ``reaction``, ``user_id``, ``item_user_id``, ``channel_id``,
+        ``message_ts``, ``event_ts``, ``raw_event``.
+
+        Matrix specifics: ``message_ts`` is the reacted-to message event id and ``event_ts``
+        this event's own id. Removing a reaction is a redaction of the m.reaction event,
+        which carries only that event's id, so ``reaction:removed`` reports it in the extra
+        ``redacts`` key while ``message_ts`` and ``reaction`` stay empty; a consumer matches
+        it against the m.reaction event it saw earlier. ``item_user_id`` is empty: resolving
+        the reacted-to message's author costs one extra room-event fetch per reaction and no
+        in-tree consumer reads the field.
+        """
+        handler = getattr(self, "_reaction_handler", None)
+        if handler is None:
+            return
+        try:
+            await handler({
+                "platform": "matrix",
+                "event_name": event_name,
+                "reaction": reaction,
+                "user_id": user_id,
+                "item_user_id": "",
+                "channel_id": room_id,
+                "message_ts": target_event_id,
+                "event_ts": event_id,
+                "redacts": removed_reaction_id,
+                "raw_event": raw_event,
+            })
+        except Exception:  # pragma: no cover - hook contract is non-blocking
+            logger.debug("Matrix: reaction hook forwarding failed", exc_info=True)
+
+    async def _on_redaction(self, event: Any) -> None:
+        """Forward a room redaction as ``reaction:removed``.
+
+        Tapping an already-set reaction off is a redaction of the user's own m.reaction event
+        and there is no other "reaction removed" event in the client-server API, so this is the
+        only signal an undo-by-tapping-again consumer ever gets. Redactions of ordinary message
+        events arrive here too (telling them apart would cost a room-event fetch) and deciding
+        what they mean is the consumer's job.
+        """
+        sender = str(getattr(event, "sender", ""))
+        if self._is_self_sender(sender):
+            return
+        event_id = str(getattr(event, "event_id", ""))
+        if self._is_duplicate_event(event_id):
+            return
+        redacted_event_id = str(getattr(event, "redacts", "") or "")
+        if not redacted_event_id:
+            return
+        room_id = str(getattr(event, "room_id", ""))
+        logger.info(
+            "Matrix: redaction from %s of %s in %s", sender, redacted_event_id, room_id
+        )
+        await self._forward_reaction_event(
+            "reaction:removed",
+            room_id=room_id,
+            user_id=sender,
+            event_id=event_id,
+            removed_reaction_id=redacted_event_id,
+            raw_event=_matrix_raw_event(event),
+        )
 
     async def _claim_reaction_prompt(
         self, registry: dict, room_id: str, reacts_to: str, key: str, sender: str, label: str, invalid_text: str,
