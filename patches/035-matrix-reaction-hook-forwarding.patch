             if await handler(room_id, reacts_to, key, sender):
                 return
+        # Not one of our prompts: hand the human reaction to the platform reaction hook
+        # (base.py ``set_reaction_handler``), which hooks/ and plugins consume.
+        await self._forward_reaction_event(
