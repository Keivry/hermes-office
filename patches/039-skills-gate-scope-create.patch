 _FLAT_OP_KEYS = ("content", "category", "file_path", "file_content", "old_string", "new_string",
diff --git a/tools/write_approval.py b/tools/write_approval.py
index 9e285d26..bf30d4f7 100644
--- a/tools/write_approval.py
+++ b/tools/write_approval.py
@@ -60,6 +60,56 @@ def _normalize_enabled(value: Any) -> bool:
     return isinstance(value, str) and value.strip().lower() in _TRUTHY_STRINGS
 
 
+# ``skills.write_approval_scope`` narrows the skills gate. "all" (default) stages every
+# skill_manage mutation, exactly as before this knob existed. "create" stages only mutations
+# that create a new skill or rewrite / delete an existing skill's SKILL.md, and lets ordinary
+# in-place edits apply immediately. Memory has no scope knob: it stays fully gated.
+SCOPE_KEY = "write_approval_scope"
+_SKILL_SCOPE_ALL = "all"
+_SKILL_SCOPE_CREATE = "create"
+_SKILL_SCOPE_VALUES = frozenset({_SKILL_SCOPE_ALL, _SKILL_SCOPE_CREATE})
+# Actions that are structural regardless of the skill's existence: a new skill, a whole-file
+# rewrite, or a removal. Supporting-file writes/removals are structural only for SKILL.md.
+_REVIEW_ACTIONS = frozenset({"create", "edit", "delete"})
+_REVIEW_FILE_ACTIONS = frozenset({"write_file", "remove_file"})
+_MAIN_SKILL_FILE = "SKILL.md"
+
+
+def skills_write_approval_scope() -> str:
+    """Read ``skills.write_approval_scope``; unset / invalid / unreadable → "all", so a broken
+    config can only keep the stricter upstream behaviour, never loosen it."""
+    try:
+        from hermes_cli.config import load_config, cfg_get
+        raw = cfg_get(load_config(), SKILLS, SCOPE_KEY, default=_SKILL_SCOPE_ALL)
+    except Exception:
+        return _SKILL_SCOPE_ALL
+    value = str(raw or "").strip().lower()
+    return value if value in _SKILL_SCOPE_VALUES else _SKILL_SCOPE_ALL
+
+
+def mutations_need_approval(mutations: Optional[List[Dict[str, Any]]] = None) -> bool:
+    """True when this skill mutation set must be staged under scope="create".
+
+    Unknown actions and empty/odd payloads return True (fail closed): a future action added
+    upstream lands in the approval queue instead of slipping past the gate.
+    """
+    if not mutations:
+        return True
+    for op in mutations:
+        if not isinstance(op, dict):
+            return True
+        action = str(op.get("action") or "").strip().lower()
+        if action in _REVIEW_ACTIONS:
+            return True
+        if action in _REVIEW_FILE_ACTIONS:
+            if str(op.get("file_path") or "").strip() in ("", _MAIN_SKILL_FILE):
+                return True
+            continue
+        if action != "patch":
+            return True
+    return False
+
+
 # --- Pending store (file-backed) ---
 
