         "write_approval": False,
+        # Scope of that gate. "all" = every skill_manage mutation stages (the behaviour above).
+        # "create" = only new skills, whole-SKILL.md rewrites and deletions stage; ordinary edits
+        # to an existing skill apply immediately. Memory has no scope knob and stays fully gated.
+        "write_approval_scope": "all",
         # Audit ledger: every skill mutation appends to ~/.hermes/skills/.curator_ledger.jsonl with
         # before/after hashes (blobs under ~/.hermes/.curator_backups/blobs/); powers `hermes
         # curator ledger` / `rollback <entry-id>`. Never a gate — failures can't block.
