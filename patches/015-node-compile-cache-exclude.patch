+def _ensure_store_excludes(store: Path) -> None:
+    """Ensure all patterns in DEFAULT_EXCLUDES are present in store/info/exclude.
+
+    The store's exclude file is written once at init, so a store created by an
+    older build is missing every pattern added since (e.g.
+    ``node-compile-cache/`` for #78888) and would snapshot it forever.
+    Reconciling on each open keeps the existing-store path in step with
+    DEFAULT_EXCLUDES.  Append-only: existing lines are never rewritten or
+    removed, so a hand-edited store keeps them.
+    """
+    info_exclude = store / "info" / "exclude"
+    try:
+        if not info_exclude.exists():
+            info_exclude.parent.mkdir(parents=True, exist_ok=True)
+            info_exclude.write_text("\n".join(DEFAULT_EXCLUDES) + "\n", encoding="utf-8")
+            return
+        content = info_exclude.read_text(encoding="utf-8")
+        existing = {line.strip() for line in content.splitlines() if line.strip()}
+        missing = [pat for pat in DEFAULT_EXCLUDES if pat not in existing]
+        if missing:
+            info_exclude.write_text(
+                content.rstrip("\n") + "\n" + "\n".join(missing) + "\n", encoding="utf-8"
+            )
+    except OSError as exc:
+        logger.warning("Could not update excludes in checkpoint store %s: %s", store, exc)
+
+
